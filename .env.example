# Backend listen port.
PORT=8080

# Optional: serve the built React app from the Go server.
# Release packages use ./web automatically, so this is mainly for development.
# FRONTEND_DIST=../autorun-go-pwa/dist

# Optional: disable browser auto-open for local packaged runs.
# AUTO_OPEN_BROWSER=0

# Optional: admin mode. Ordinary local users can leave these empty and log in
# from the web page with phone + password.
# RUN_PHONE=
# RUN_PASSWORD=
# ADMIN_TOKEN=

# Optional: local session storage. By default this writes to the current user's
# config directory. Use one of these only if you want to choose the location.
# AUTORUN_DATA_DIR=
# SESSION_STORE_PATH=
